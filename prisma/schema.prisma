generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model super_admin {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  name      String
  password  String
  role      Role
  createdAt DateTime @default(now())
}
